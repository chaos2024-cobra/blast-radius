+class TeradataConversion(Expression):
+    """A postfix type conversion with Teradata-specific conversion or formatting semantics."""
+
+    arg_types = {"this": True, "to": True, "format": False}
+
+    @property
+    def name(self) -> str:
+        return self.this.name
+
+    @property
