+        remaining = []
+        kept = default
+        for case in ifs:
+            if always_true(case.this):
+                kept = case.args["true"]
+                break
+            if not always_false(case.this):
+                remaining.append(case)
+
+        if len(remaining) == len(ifs) or kept is None:
