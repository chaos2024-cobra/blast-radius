diff --git a/sqlglot/generators/duckdb.py b/sqlglot/generators/duckdb.py
index a0fa169c7..2aabd74a6 100644
--- a/sqlglot/generators/duckdb.py
+++ b/sqlglot/generators/duckdb.py
@@ -1593,6 +1593,15 @@ def _sha_sql(
     return self.func("UNHEX", result) if is_binary else result
 
 
+def _unqualify_pivot_columns(expression: exp.Expr) -> exp.Expr:
+    # DuckDB requires unqualified pivot expressions. The source and CTEs have their own scope.
+    # https://github.com/duckdb/duckdb/blob/671faf92411182f81dce42ac43de8bfb05d9909e/src/planner/binder/tableref/bind_pivot.cpp#L61-L62
+    for clause in expression.iter_expressions():
+        if clause.arg_key not in ("this", "with_"):
+            transforms.unqualify_columns(clause)
+    return expression
+
+
 class DuckDBGenerator(generator.Generator):
     PARAMETER_TOKEN = "$"
     NAMED_PLACEHOLDER_TOKEN = "$"
@@ -1787,9 +1796,7 @@ class DuckDBGenerator(generator.Generator):
         exp.NextDay: _day_navigation_sql,
         exp.PercentileCont: rename_func("QUANTILE_CONT"),
         exp.PercentileDisc: rename_func("QUANTILE_DISC"),
-        # DuckDB doesn't allow qualified columns inside of PIVOT expressions.
-        # See: https://github.com/duckdb/duckdb/blob/671faf92411182f81dce42ac43de8bfb05d9909e/src/planner/binder/tableref/bind_pivot.cpp#L61-L62
-        exp.Pivot: transforms.preprocess([transforms.unqualify_columns]),
+        exp.Pivot: transforms.preprocess([_unqualify_pivot_columns]),
         exp.PreviousDay: _day_navigation_sql,
         exp.RegexpILike: lambda self, e: self.func(
             "REGEXP_MATCHES", e.this, e.expression, exp.Literal.string("i")
diff --git a/tests/dialects/test_duckdb.py b/tests/dialects/test_duckdb.py
index 99b5077b5..38b0ab3e5 100644
--- a/tests/dialects/test_duckdb.py
+++ b/tests/dialects/test_duckdb.py
@@ -3291,6 +3291,17 @@ class TestDuckDB(Validator):
 
         self.validate_identity("DETACH DATABASE db", "DETACH db")
 
+    def test_pivot_source_qualifiers(self):
+        source = (
+            "SELECT s.region, s.amount FROM (VALUES ('east', 2), ('west', 5)) AS s(region, amount) "
+            "JOIN (VALUES ('east')) AS r(region) ON s.region = r.region"
+        )
+        self.validate_identity(
+            f"PIVOT ({source}) ON s.region USING SUM(s.amount)",
+            f"PIVOT ({source}) ON region USING SUM(amount)",
+        )
+        self.validate_identity(f"WITH sales AS ({source}) PIVOT sales ON region USING SUM(amount)")
+
     def test_simplified_pivot_unpivot(self):
         self.validate_identity("PIVOT Cities ON Year USING SUM(Population)")
         self.validate_identity("PIVOT Cities ON Year USING FIRST(Population)")
