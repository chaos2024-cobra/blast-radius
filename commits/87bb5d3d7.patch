diff --git a/sqlglot/generators/presto.py b/sqlglot/generators/presto.py
index 5a0872a62..cb2d5b238 100644
--- a/sqlglot/generators/presto.py
+++ b/sqlglot/generators/presto.py
@@ -551,6 +551,29 @@ class PrestoGenerator(generator.Generator):
 
         return self.sql(to_unix)
 
+    def addmonths_sql(self, expression: exp.AddMonths) -> str:
+        this = expression.this
+        if this.is_string or this.is_type(*exp.DataType.TEXT_TYPES):
+            this = exp.TimeStrToTime(this=this)
+        if expression.is_type(exp.DType.DATE) and not this.is_type(exp.DType.DATE):
+            this = exp.cast(this, exp.DType.DATE)
+
+        added = exp.DateAdd(this=this, expression=expression.expression, unit=exp.var("MONTH"))
+
+        if not expression.args.get("preserve_end_of_month"):
+            return self.sql(added)
+
+        # Shift the original value by whole days to preserve its time of day.
+        eom_shift = exp.DateDiff(
+            this=exp.LastDay(this=added.copy()),
+            expression=exp.cast(this, exp.DType.DATE),
+            unit=exp.var("DAY"),
+        )
+        to_eom = exp.DateAdd(this=this.copy(), expression=eom_shift, unit=exp.var("DAY"))
+        is_eom = exp.Day(this=this.copy()).eq(exp.Day(this=exp.LastDay(this=this.copy())))
+
+        return self.sql(exp.case().when(is_eom, to_eom).else_(added))
+
     def jsonformat_sql(self, expression: exp.JSONFormat) -> str:
         this = expression.this
         is_json = expression.args.get("is_json")
diff --git a/tests/dialects/test_trino.py b/tests/dialects/test_trino.py
index 398e968b6..5df5b99f9 100644
--- a/tests/dialects/test_trino.py
+++ b/tests/dialects/test_trino.py
@@ -520,6 +520,43 @@ class TestTrino(Validator):
             identify=True,
         )
 
+    def test_add_months(self):
+        self.validate_all(
+            "SELECT DATE_ADD('MONTH', 1, d)",
+            read={"": "SELECT ADD_MONTHS(d, 1)"},
+        )
+
+        source = "FROM (SELECT '2019-02-28' AS d) AS t"
+        for arg in ("'2019-02-28'", "t.d"):
+            with self.subTest(arg=arg):
+                expression = annotate_types(
+                    parse_one(f"SELECT ADD_MONTHS({arg}, 1) {source}", read="snowflake"),
+                    dialect="snowflake",
+                )
+                timestamp = f"CAST({arg} AS TIMESTAMP)"
+                added = f"DATE_ADD('MONTH', 1, {timestamp})"
+                self.assertEqual(
+                    expression.sql(self.dialect),
+                    f"SELECT CASE WHEN DAY({timestamp}) = DAY(LAST_DAY_OF_MONTH({timestamp})) "
+                    f"THEN DATE_ADD('DAY', DATE_DIFF('DAY', CAST({timestamp} AS DATE), "
+                    f"LAST_DAY_OF_MONTH({added})), {timestamp}) ELSE {added} END {source}",
+                )
+
+        for dialect, arg, expected in (
+            ("spark", "DATE '2019-02-28'", "CAST('2019-02-28' AS DATE)"),
+            (
+                "spark",
+                "TIMESTAMP '2019-02-15 12:34:56'",
+                "CAST(CAST('2019-02-15 12:34:56' AS TIMESTAMP WITH TIME ZONE) AS DATE)",
+            ),
+            ("databricks", "'2019-02-28'", "CAST(CAST('2019-02-28' AS TIMESTAMP) AS DATE)"),
+        ):
+            with self.subTest(dialect=dialect, arg=arg):
+                expression = annotate_types(
+                    parse_one(f"ADD_MONTHS({arg}, 1)", read=dialect), dialect=dialect
+                )
+                self.assertEqual(expression.sql(self.dialect), f"DATE_ADD('MONTH', 1, {expected})")
+
     def test_analyze(self):
         self.validate_identity("ANALYZE tbl")
         self.validate_identity("ANALYZE tbl WITH (prop1=val1, prop2=val2)")
